{
  "realm": "palestra",
  "displayName": "Palestra",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "rememberMe": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "it",
    "en"
  ],
  "defaultLocale": "it",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@palestra.local",
    "fromDisplayName": "Palestra",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Amministratore della palestra: gestisce corsi, istruttori e abbonamenti"
      }
    ]
  },
  "clients": [
    {
      "clientId": "palestra-spa",
      "name": "Palestra - frontend Angular",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*##http://localhost:4200/*"
      },
      "protocolMappers": [
        {
          "name": "audience-palestra-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "palestra-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "palestra-swagger",
      "name": "Palestra - Swagger UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8081/*"
      ],
      "webOrigins": [
        "http://localhost:8081"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-palestra-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "palestra-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
